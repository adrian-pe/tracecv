# Optional: GitHub personal access token to increase API rate limits.
GITHUB_TOKEN=github_pat_your_token_here

# Optional: override GitHub API base URL.
GITHUB_API_BASE_URL=https://api.github.com

# Optional: comma-separated list of origins allowed to call /api routes.
# Leave empty to reflect the incoming origin, which works for same-app Vercel deployments.
CORS_ALLOWED_ORIGINS=

# Optional: only needed if a separate frontend must call this deployment's API.
# The bundled frontend defaults to same-origin /api.
NEXT_PUBLIC_API_BASE_URL=/api
