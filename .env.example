# Required: Supabase Auth provider for email OTP login.
# Enable the Email provider in Supabase Auth and copy these values from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: GitHub personal access token to increase API rate limits.
GITHUB_TOKEN=github_pat_your_token_here

# Optional: override GitHub API base URL.
GITHUB_API_BASE_URL=https://api.github.com

# Optional: comma-separated list of origins allowed to call /api routes.
# Leave empty to reflect the incoming origin, which works for same-app Vercel deployments.
CORS_ALLOWED_ORIGINS=

# Optional: only needed if a separate frontend must call this deployment's API.
# The bundled frontend defaults to same-origin /api.
NEXT_PUBLIC_API_BASE_URL=/api

# Optional: enable automatic Stellar anchoring after GitHub CV generation.
# Supported STELLAR_NETWORK values: testnet (default), public/mainnet/pubnet, futurenet, custom.
# This must be a network name, not a URL. Do not set it to https://soroban-testnet.stellar.org.
STELLAR_NETWORK=testnet
STELLAR_SECRET_KEY=S...
STELLAR_PUBLIC_KEY=G...

# Optional: override Horizon URL. Required only for custom/private networks.
# For testnet Horizon use https://horizon-testnet.stellar.org; Soroban RPC URLs are not supported here.
STELLAR_HORIZON_URL=

# Optional: passphrase required only when STELLAR_NETWORK=custom.
STELLAR_NETWORK_PASSPHRASE=
