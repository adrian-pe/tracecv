# Required: Supabase Auth provider for email OTP login.
# Enable the Email provider in Supabase Auth and copy these values from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: public app URL used to build OAuth callback URLs behind proxies.
# Configure the same URL in Supabase Auth redirect allow-list with /api/auth/github/callback.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for GitHub connector OAuth: enable GitHub in Supabase Auth > Providers > GitHub.
# Add GitHub OAuth App Client ID/Secret there, then include the callback URL:
# http://localhost:3000/api/auth/github/callback (or your production domain).

# Required: server-side Supabase PostgREST access for persisted app data.
# Keep this key secret; never expose it to client components.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: direct Postgres connection string for CLI migrations and admin tasks.
# Example: postgresql://postgres.your-project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project:password@your-supabase-pooler.supabase.com:6543/postgres

# Optional: GitHub personal access token to increase API rate limits.
GITHUB_TOKEN=github_pat_your_token_here

# Optional: override GitHub API base URL.
GITHUB_API_BASE_URL=https://api.github.com

# Optional: comma-separated list of origins allowed to call /api routes.
# Leave empty to reflect the incoming origin, which works for same-app Vercel deployments.
CORS_ALLOWED_ORIGINS=

# Optional: only needed if a separate frontend must call this deployment's API.
# The bundled frontend defaults to same-origin /api.
NEXT_PUBLIC_API_BASE_URL=/api

# Optional: enable automatic Stellar anchoring after GitHub CV generation.
# Supported STELLAR_NETWORK values: testnet (default), public/mainnet/pubnet, futurenet, custom.
# This must be a network name, not a URL. Do not set it to https://soroban-testnet.stellar.org.
STELLAR_NETWORK=testnet
STELLAR_SECRET_KEY=S...
STELLAR_PUBLIC_KEY=G...

# Optional: override Horizon URL. Required only for custom/private networks.
# For testnet Horizon use https://horizon-testnet.stellar.org; Soroban RPC URLs are not supported here.
STELLAR_HORIZON_URL=

# Optional: passphrase required only when STELLAR_NETWORK=custom.
STELLAR_NETWORK_PASSPHRASE=
